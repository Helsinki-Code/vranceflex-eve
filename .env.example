# Required by the lead-researcher subagent for Parallel FindAll and Task MCP.
# Configure the real value in the local environment or deployment secret manager.
PARALLEL_API_KEY=

# Email verification: confirms a prospect's address can receive mail before it
# counts as a verified lead (and costs the customer a credit). Set ONE of these;
# Reoon is used first when both are set. Without either, no address is ever
# treated as verified, so nothing can be emailed. The cost is covered by
# prospect credits, so customers never need their own key.
REOON_API_KEY=
ZEROBOUNCE_API_KEY=

# Optional for local AI Gateway access. Vercel deployments can use project OIDC.
AI_GATEWAY_API_KEY=

# Managed PostgreSQL connection. Required for durable production persistence.
DATABASE_URL=

# First-party authentication. Use at least 32 random characters and keep it
# server-side. Rotating this invalidates outstanding OTP hashes.
AUTH_SECRET=

# Resend platform account. Used ONLY for signup/password OTPs and team-invite
# email — never for client outreach. Outreach email and SMS are BYOK: each
# workspace connects its own Resend/Twilio account from Settings → Integrations
# (stored encrypted in the database, see CREDENTIALS_ENCRYPTION_KEY below).
# There is no global outreach fallback and no global Twilio config anymore.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VranceFlex <auth@example.com>

# AES-256-GCM key (32 bytes, base64url-encoded) used to encrypt each client
# workspace's connected Resend/Twilio credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never reuse AUTH_SECRET for this — rotating one must not affect the other.
CREDENTIALS_ENCRYPTION_KEY=

# Physical mailing address included in outbound outreach email footers (CAN-SPAM
# requirement). Plain text, e.g. "Acme Inc, 123 Main St, Springfield, ST 00000".
COMPANY_MAILING_ADDRESS=

# Public base URL of this deployment, used to build the one-click unsubscribe
# link embedded in outreach email (app/api/unsubscribe/[messageId]).
# Example: https://app.vranceflex.com
APP_BASE_URL=

# Safe, public iframe URL returned after creating a LiveAvatar embedding.
# Example: https://embed.liveavatar.com/v1/<embedding-id>
# The LIVEAVATAR_API_KEY used to create it must never be exposed to this app.
NEXT_PUBLIC_LIVEAVATAR_EMBED_URL=

# Temporary local/demo campaign persistence is enabled automatically outside production.
# Production APIs stay closed until authentication is configured. Set this only for an
# intentionally public, non-sensitive demonstration deployment.
# SMS outreach is hidden and blocked unless this is "true". Cold text messages
# carry real legal exposure (for example the US TCPA), so leave it off until
# email is proven and compliance has been reviewed. Replies like STOP to texts
# already sent are always honored, whatever this is set to.
VRANCEFLEX_SMS_ENABLED=false
VRANCEFLEX_DEMO_MODE=false

# VranceFlex platform billing. `npm run stripe:setup` creates every product,
# price, the customer-portal configuration and (with --webhook-url) the webhook
# endpoint, then prints the values below. Launch, Growth and Agency are
# self-serve; Enterprise is sales-led, so STRIPE_PRICE_ID_ENTERPRISE only maps
# hand-made contract subscriptions back to the plan. STRIPE_PRICE_ID_PRO is a
# deprecated fallback for Growth monthly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LAUNCH_MONTHLY=
STRIPE_PRICE_ID_LAUNCH_YEARLY=
STRIPE_PRICE_ID_GROWTH_MONTHLY=
STRIPE_PRICE_ID_GROWTH_YEARLY=
STRIPE_PRICE_ID_AGENCY_MONTHLY=
STRIPE_PRICE_ID_AGENCY_YEARLY=
STRIPE_PRICE_ID_ENTERPRISE=
STRIPE_PRICE_ID_TOPUP_100=
STRIPE_PRICE_ID_TOPUP_500=
STRIPE_PRICE_ID_TOPUP_2000=
STRIPE_PORTAL_CONFIGURATION_ID=
# Set to true only after activating Stripe Tax in the Dashboard.
STRIPE_AUTOMATIC_TAX=false
# Protects /api/cron/billing-reconcile (Vercel Cron sends it as a bearer token).
CRON_SECRET=
# STRIPE_PRICE_ID_PRO=


# ---- AI voice calling (optional paid add-on) -------------------------------------
# LiveKit places the calls over each customer's own Twilio SIP trunk. The voice
# WORKER (voice-worker/, a separate always-on process) holds the conversations.
# See voice-worker/README.md. Set the same LIVEKIT_* and VOICE_WORKER_SECRET on
# the worker. APP_BASE_URL must be the public URL the worker posts reports to.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=vranceflex-caller
# A long random string shared by the app and the worker; signs every call report.
VOICE_WORKER_SECRET=
# Stripe prices (create them in Stripe, then paste the price ids). The add-on is
# a monthly price added to the customer's subscription; packs are one-time.
STRIPE_PRICE_ID_VOICE_ADDON_MONTHLY=
STRIPE_PRICE_ID_VOICE_PACK_60=
STRIPE_PRICE_ID_VOICE_PACK_300=
STRIPE_PRICE_ID_VOICE_PACK_1000=
# Minutes the add-on includes each billing period (default 120).
VOICE_ADDON_INCLUDED_MINUTES=120
